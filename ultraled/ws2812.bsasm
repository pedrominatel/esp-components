# Expand each 16-lane mask into four samples: 0 -> 1000, 1 -> 1110.
cfg prefetch false
cfg eof_on upstream
cfg trailing_bytes 1

loop:
    read 16,
    set 0..15 H, set 16..31 48..63,
    write 32
    set 0..15 48..63, set 16..31 L,
    write 32,
    jmp loop
